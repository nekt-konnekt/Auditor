# Primary AI provider: Gemini. Gemini is attempted first unless changed here.
AI_PRIMARY_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Ordered fallback providers, tried in order when the primary provider fails.
# Supported: gemini, alibaba, groq, openrouter, openai-compatible
AI_FALLBACK_PROVIDERS="alibaba"

# Alibaba Cloud Model Studio fallback
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL="qwen-plus"

# Optional additional fallback keys/models
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# For a custom OpenAI-compatible provider, include openai-compatible in AI_FALLBACK_PROVIDERS
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL=""

# APP_URL: optional public URL where Auditor is hosted.
APP_URL=""

# Required in production: internal-tool Basic Auth (set strong unique secrets in Railway/Vercel).
AUDITOR_USERNAME=""
AUDITOR_PASSWORD=""

# Optional durable report storage (required for cross-instance report retrieval/comparisons).
# Configure a Neon PostgreSQL pooled connection string when database persistence is enabled.
DATABASE_URL=""
