# Alibaba Cloud Model Studio (Singapore / International deployment)
# Create an API key in Model Studio and configure Free Quota Only to avoid unexpected charges.
DASHSCOPE_API_KEY=""
# Optional: set the exact OpenAI-compatible base URL shown for your Model Studio workspace.
# If omitted, Auditor uses the standard international DashScope endpoint.
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# Optional; defaults to qwen-plus. Choose a model available to your Model Studio workspace.
DASHSCOPE_MODEL="qwen-plus"

# APP_URL: optional public URL where Auditor is hosted.
APP_URL=""
